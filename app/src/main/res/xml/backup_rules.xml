<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 o menos: sin copias de seguridad de nada (ver data_extraction_rules.xml para Android 12+) -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
