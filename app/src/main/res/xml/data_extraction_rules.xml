<?xml version="1.0" encoding="utf-8"?>
<!-- Nada de la app sale del dispositivo en copias de seguridad ni en transferencias: el carrito, el tema y,
     sobre todo, los datos cifrados con una clave que no viaja con ellos -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
